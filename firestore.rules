rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for validation
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // Members collection rules
    match /members/{memberId} {
      allow read, write: if true;
    }

    // Bills collection rules
    match /bills/{billId} {
      allow read, write: if true;
    }

    // Finances collection rules
    match /finances/{recordId} {
      allow read, write: if true;
    }

    // Donations collection rules
    match /donations/{campaignId} {
      allow read, write: if true;
    }

    // Forum posts collection rules
    match /posts/{postId} {
      allow read, write: if true;
    }

    // News collection rules
    match /news/{newsId} {
      allow read, write: if true;
    }

    // Settings collection rules
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
